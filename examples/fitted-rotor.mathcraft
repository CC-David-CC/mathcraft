{"format":"mathcraft","version":1,"engine":"GNU Octave 7.2.0 · octave-wasm 0.0.1","params":{"mass_kg":1,"stiffness_n_m":10000,"unbalance_g_mm":1000,"damping_ratio":0.079981742883487},"maxRPM":2200,"source":"function [amplitude_mm, phase_deg] = unbalance(rpm, p)\n  % Peak steady-state displacement and phase lag relative to rotating force.\n  % SI inputs except rpm, unbalance in g*mm, and output displacement in mm.\n  r = (rpm(:) .* (2*pi/60)) ./ sqrt(p.stiffness_n_m / p.mass_kg);\n  elastic = 1 - r.^2;\n  viscous = 2 .* p.damping_ratio .* r;\n  scale_mm = 1e-3 * p.unbalance_g_mm / p.mass_kg;\n  amplitude_mm = scale_mm .* r.^2 ./ hypot(elastic, viscous);\n  phase_deg = atan2(viscous, elastic) .* (180/pi);\n  if (p.unbalance_g_mm == 0)\n    amplitude_mm(:) = 0;\n    phase_deg(:) = NaN;\n  else\n    phase_deg(r == 0) = NaN;\n    singular = (p.damping_ratio == 0) & (abs(r - 1) <= 8*eps);\n    amplitude_mm(singular) = NaN;\n    phase_deg(singular) = NaN;\n  end\nend\n","dataset":{"name":"Synthetic run · 15 observations","csv":"rpm,amplitude_mm,phase_deg\n250,0.07651,2.575\n450,0.27612,5.536\n650,0.86007,11.471\n780,1.84297,21.439\n850,3.17621,34.440\n900,4.69482,53.463\n940,6.08129,78.857\n955,6.21546,90.053\n980,6.12085,107.951\n1020,5.13561,129.509\n1100,3.55872,150.587\n1250,2.29136,163.640\n1500,1.67234,170.281\n1800,1.37308,173.263\n2100,1.26241,174.759\n"},"script":"% This cell receives p, rpm, measured_rpm and measured_mm from the worksheet.\nnatural_rpm = 60/(2*pi) * sqrt(p.stiffness_n_m / p.mass_kg);\n[a, lag] = unbalance(natural_rpm, p);\nprintf(\"Natural speed: %.3f rpm\\n\", natural_rpm);\nprintf(\"Displacement at natural speed: %.6g mm peak\\n\", a);\nprintf(\"Phase lag: %.3f degrees\\n\", lag);\n","reference":{"name":"Reference at 5% damping","time":"2026-11-21T00:49:07.030Z","engine":"GNU Octave 7.2.0 · octave-wasm 0.0.1","inputs":{"params":{"mass_kg":1,"stiffness_n_m":10000,"unbalance_g_mm":1000,"damping_ratio":0.05},"maxRPM":2200,"source":"function [amplitude_mm, phase_deg] = unbalance(rpm, p)\n  % Peak steady-state displacement and phase lag relative to rotating force.\n  % SI inputs except rpm, unbalance in g*mm, and output displacement in mm.\n  r = (rpm(:) .* (2*pi/60)) ./ sqrt(p.stiffness_n_m / p.mass_kg);\n  elastic = 1 - r.^2;\n  viscous = 2 .* p.damping_ratio .* r;\n  scale_mm = 1e-3 * p.unbalance_g_mm / p.mass_kg;\n  amplitude_mm = scale_mm .* r.^2 ./ hypot(elastic, viscous);\n  phase_deg = atan2(viscous, elastic) .* (180/pi);\n  if (p.unbalance_g_mm == 0)\n    amplitude_mm(:) = 0;\n    phase_deg(:) = NaN;\n  else\n    phase_deg(r == 0) = NaN;\n    singular = (p.damping_ratio == 0) & (abs(r - 1) <= 8*eps);\n    amplitude_mm(singular) = NaN;\n    phase_deg(singular) = NaN;\n  end\nend\n","dataset":{"name":"Synthetic run · 15 observations","csv":"rpm,amplitude_mm,phase_deg\n250,0.07651,2.575\n450,0.27612,5.536\n650,0.86007,11.471\n780,1.84297,21.439\n850,3.17621,34.440\n900,4.69482,53.463\n940,6.08129,78.857\n955,6.21546,90.053\n980,6.12085,107.951\n1020,5.13561,129.509\n1100,3.55872,150.587\n1250,2.29136,163.640\n1500,1.67234,170.281\n1800,1.37308,173.263\n2100,1.26241,174.759\n"}},"result":{"curve":[[0,0,null],[4.583333333333333,0.000023037220419161947,0.02750063141179205],[9.166666666666666,0.00009215521882825402,0.05500505164113525],[13.75,0.0002073730110187372,0.08251705123993108],[18.333333333333332,0.00036872230443736614,0.11004042423044351],[22.916666666666664,0.0005762475198969723,0.1375789698446376],[27.5,0.0008300058220102092,0.16513649426851457],[32.08333333333333,0.0011300671583849976,0.1927168123931211],[36.666666666666664,0.0014765143076316276,0.2203237495739234],[41.25,0.00186944293624275,0.24796114340024641],[45.83333333333333,0.0023089616644189673,0.27563284547650085],[50.416666666666664,0.002795192140924264,0.3033427232169338],[55,0.0033282691270673055,0.33109466165566687],[59.58333333333333,0.003908340589916559,0.35889256527380575],[64.16666666666666,0.004535567804869399,0.3867403598454388